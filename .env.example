# ---------- Сервер ----------
PORT=3010
# Секрет для подписи сессий (любая длинная случайная строка: openssl rand -hex 32)
SESSION_SECRET=change_me

# ---------- Битрикс24 ----------
# Только этот портал может открыть приложение
BITRIX_DOMAIN=myarbitr.bitrix24.kz
# Кто видит отчёт, настраивается в самом приложении (раздел «Доступ»),
# список хранится в data/access.json

# ---------- 1С Фреш (OData) ----------
# Адрес приложения из браузера + /odata/standard.odata
# пример: https://1cfresh.kz/a/ea/1234567/odata/standard.odata
ODATA_URL=
ODATA_USER=
ODATA_PASSWORD=

# Имена объектов конфигурации (проверь через npm run discover)
REG_ACCOUNTING=AccountingRegister_Типовой
CHART_OF_ACCOUNTS=ChartOfAccounts_Типовой
REG_RESOURCE=Сумма
DOC_INVOICE=Document_СчетНаОплатуПокупателю
CAT_CLIENTS=Catalog_Контрагенты
CAT_USERS=Catalog_Пользователи

# Счета учёта (коды плана счетов, через запятую)
# 1210 - дебиторка покупателей, 3510 - авансы полученные
ACC_RECEIVABLE=1210
ACC_ADVANCES=3510

# Сколько дней даём на оплату после начисления, дальше считаем просрочкой
PAYMENT_TERM_DAYS=5
# Насколько глубоко назад смотреть начисления для расчёта возраста долга
AGING_LOOKBACK_MONTHS=24
# Кэш ответов 1С, минут
CACHE_TTL_MIN=10

# ---------- Отладка ----------
# 1 = фейковые данные без 1С (посмотреть интерфейс)
MOCK=0
# 1 = открывать без Битрикса (только локально!)
DEV_NO_AUTH=0

# Входящий вебхук Битрикса (права: crm, user, department). Нужен для филиалов, ссылок на сделки и выставления счетов.
# Хранить только в .env, в репозиторий не добавлять.
BITRIX_WEBHOOK=https://ВАШ-ПОРТАЛ.bitrix24.kz/rest/ID/КОД/

# Компании (до 9). Для каждой: имя и адрес OData своей базы 1С Фреш
CO1_ID=moy
CO1_NAME=Мой арбитр
CO1_ODATA_URL=https://1cfresh.kz/a/ea000/000001/odata/standard.odata
CO1_ODATA_USER=odata.user
CO1_ODATA_PASSWORD=
CO2_ID=arbitr
CO2_NAME=АрбитрЪ
CO2_ODATA_URL=https://1cfresh.kz/a/ea000/000002/odata/standard.odata
CO2_ODATA_USER=odata.user
CO2_ODATA_PASSWORD=
